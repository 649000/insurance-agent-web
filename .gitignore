# ==============================================================================
# Insurance Agent Web - .gitignore
# Tech Stack: Turborepo, pnpm (Node.js 20+ LTS), Next.js App Router,
#             Python (uv, pytest, ruff), Firebase (Auth, Functions, Storage),
#             Supabase PostgreSQL, Playwright & Vitest
# ==============================================================================

# ------------------------------------------------------------------------------
# Dependencies & Package Managers
# ------------------------------------------------------------------------------
node_modules/
.pnpm-store/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ------------------------------------------------------------------------------
# Build Outputs & Monorepo Cache
# ------------------------------------------------------------------------------
.turbo/
dist/
build/
out/
.next/
*.tsbuildinfo

# ------------------------------------------------------------------------------
# Python & Virtual Environments (uv, pytest, ruff)
# ------------------------------------------------------------------------------
.venv/
venv/
env/
ENV/
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
coverage/
htmlcov/
*.egg-info/
*.egg
.uv/

# ------------------------------------------------------------------------------
# Testing & Reports (Vitest, Playwright)
# ------------------------------------------------------------------------------
test-results/
playwright-report/
blob-report/
playwright/.cache/
.vitest/

