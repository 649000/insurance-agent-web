{
  "functions": {
    "source": "services/functions",
    "runtime": "python313",
    "codebase": "default",
    "ignore": [
      ".git",
      ".venv",
      "__pycache__",
      ".pytest_cache",
      ".ruff_cache",
      "tests"
    ]
  },
  "storage": {
    "rules": "storage.rules"
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "functions": {
      "port": 5001
    },
    "storage": {
      "port": 9199
    },
    "ui": {
      "enabled": true,
      "port": 4000
    },
    "singleProjectMode": true
  }
}
