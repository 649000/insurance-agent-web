# ==============================================================================
# Client / Next.js Environment Variables (apps/web)
# Note: ONLY public keys prefixed with NEXT_PUBLIC_ may be exposed to the browser.
# NEVER put service role keys or Firebase Admin credentials here.
# ==============================================================================

# Supabase Local / Remote
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJh...

# Firebase Client SDK (Auth, Storage)
NEXT_PUBLIC_FIREBASE_API_KEY=mock-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=insurance-agent-dev.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=insurance-agent-dev
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=insurance-agent-dev.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:mockappid

# Firebase Emulators Toggle (true for local development)
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099
NEXT_PUBLIC_FIREBASE_FUNCTIONS_EMULATOR_URL=http://127.0.0.1:5001

# ==============================================================================
# Python Firebase Cloud Functions (services/functions)
# ==============================================================================
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
FIREBASE_PROJECT_ID=insurance-agent-dev
